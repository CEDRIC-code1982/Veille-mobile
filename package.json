{
  "name": "veille-mobile",
  "private": true,
  "type": "module",
  "description": "Automated mobile technology watch pipeline and static site",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "collect": "tsx src/scripts/collect.ts",
    "classify": "tsx src/scripts/classify.ts",
    "verify": "tsx src/scripts/verify.ts",
    "publish": "tsx src/scripts/publish.ts",
    "icons": "tsx src/tools/generateIcons.ts",
    "check:privacy": "tsx src/tools/checkPrivacy.ts",
    "check:feeds": "tsx src/tools/checkFeeds.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "fast-xml-parser": "^5.11.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "volta": {
    "node": "22.23.2"
  }
}
